# Life Agile settings. Copy to .env and edit. Every value is optional.

# Public address of the app. Needed for Google login, invite links and HTTPS cookies.
# Without it, the app accepts the address you open it with.
# PUBLIC_URL=https://agile.example.com

# Host port for docker compose (default 8080).
# HOST_PORT=8080

# Time zone for days, sprints and reminders (IANA name). Default: Europe/Istanbul.
# APP_TIMEZONE=Europe/Istanbul

# Optional Google login. Redirect URI: PUBLIC_URL/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: create these accounts at start (email:Name, comma separated). They log in with Google
# or set a password later. Without it, the first visitor creates the admin account at /kurulum.
# ALLOWED_EMAILS=ada@example.com:Ada,can@example.com:Can

# Optional Web Push keys (npx web-push generate-vapid-keys). Without them, keys are created in data/vapid.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Public holidays on the calendars and in capacity: TR (default) or none.
# HOLIDAYS=TR

# Optional: link to the source code shown in the app (AGPL-3.0). Change it if you run a modified version.
# SOURCE_URL=https://github.com/okaldev/life-agile
